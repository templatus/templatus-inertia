{
  "name": "templatus-inertia",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "format": "prettier . --write --plugin=@prettier/plugin-ruby --plugin=prettier-plugin-tailwindcss",
    "test": "vitest",
    "lint": "eslint --cache .",
    "tsc": "tsc --noEmit",
    "size": "bun run size-limit"
  },
  "dependencies": {
    "@honeybadger-io/js": "^6.17.0",
    "@inertiajs/svelte": "^3.9.1",
    "@plausible-analytics/tracker": "^0.4.6",
    "@rails/actioncable": "^8.1.400",
    "@tabler/icons-svelte": "^3.49.0",
    "timeago.js": "^4.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prettier/plugin-ruby": "^4.0.4",
    "@size-limit/file": "^14.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@tsconfig/svelte": "^5.0.8",
    "@types/rails__actioncable": "^8.0.3",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.0.5",
    "acorn": "^8.19.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-svelte": "^3.23.1",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "size-limit": "^14.2.0",
    "svelte": "^5.57.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.4",
    "vite-plugin-full-reload": "^1.2.0",
    "vite-plugin-rails": "^0.6.0",
    "vitest": "^5.0.5"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "vite"
  ],
  "size-limit": [
    {
      "limit": "90 kB",
      "path": "public/{vite,vite-dev,vite-test}/assets/*.js"
    }
  ],
  "engines": {
    "bun": "1.4.x"
  }
}
